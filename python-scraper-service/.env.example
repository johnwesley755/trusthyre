# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Security & Inter-Service Authentication
INTERNAL_SERVICE_SECRET=trusthire_scraper_dev_secret_2026

# Database Connection (Neon PostgreSQL or Local PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/trusthire

# Crawl & Scraping Budgets
MAX_CONCURRENT_REQUESTS_PER_SOURCE=3
REQUEST_TIMEOUT_SECONDS=10
CRAWL_MAX_DEPTH=2
DEFAULT_SCAN_LIMIT=25

# External Job Provider APIs (Optional - Adapter reports AUTH_REQUIRED if unconfigured)
HEADCOUNTLABS_API_KEY=

# Target Geo Filter
DEFAULT_TARGET_CITY=Chennai
