generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
  engineType      = "library"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model early_access_requests {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email      String    @db.VarChar(255)
  source     String    @db.VarChar(50)
  created_at DateTime? @default(now()) @db.Timestamp(6)

  @@unique([email, source])
}

model employer_profiles {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id         String    @unique @db.VarChar(255)
  company_name    String?   @db.VarChar(255)
  industry        String?   @db.VarChar(100)
  company_website String?
  profile_bio     String?
  business_tier   String?   @db.VarChar(50)
  is_verified     Boolean?  @default(false)
  location        String?   @db.VarChar(255)
  city            String?   @db.VarChar(255)
  address         String?
  latitude        Float?
  longitude       Float?
  created_at      DateTime? @default(now()) @db.Timestamp(6)
  updated_at      DateTime? @default(now()) @db.Timestamp(6)

  @@index([user_id], map: "idx_employer_profiles_user_id")
}

model flyway_schema_history_auth {
  installed_rank Int      @id(map: "flyway_schema_history_auth_pk")
  version        String?  @db.VarChar(50)
  description    String   @db.VarChar(200)
  type           String   @db.VarChar(20)
  script         String   @db.VarChar(1000)
  checksum       Int?
  installed_by   String   @db.VarChar(100)
  installed_on   DateTime @default(now()) @db.Timestamp(6)
  execution_time Int
  success        Boolean

  @@index([success], map: "flyway_schema_history_auth_s_idx")
}

model job_applications {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  job_id       String    @db.Uuid
  worker_id    String    @db.VarChar(255)
  status       String?   @default("PENDING") @db.VarChar(50)
  cover_letter String?
  applied_at   DateTime? @default(now()) @db.Timestamp(6)
  jobs         jobs      @relation(fields: [job_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([job_id], map: "idx_job_applications_job_id")
  @@index([worker_id], map: "idx_job_applications_worker_id")
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model job_required_skills {
  job_id String @db.Uuid
  skill  String @db.VarChar(255)
  jobs   jobs   @relation(fields: [job_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@ignore
}

model job_search_index {
  job_id          String    @id @db.Uuid
  title           String    @db.VarChar(255)
  description     String?
  category        String?   @db.VarChar(100)
  location        String?   @db.VarChar(255)
  city            String?   @db.VarChar(255)
  address         String?
  latitude        Float?
  longitude       Float?
  level           String?   @db.VarChar(20)
  required_skills String?   @db.VarChar(255)
  budget          Float?
  status          String?   @db.VarChar(50)
  indexed_at      DateTime? @default(now()) @db.Timestamp(6)
  last_updated_at DateTime? @default(now()) @db.Timestamp(6)
  employer_name   String?   @db.VarChar(255)

  @@index([category], map: "idx_job_search_category")
  @@index([city], map: "idx_job_search_city")
  @@index([status], map: "idx_job_search_status")
}

model jobs {
  id                        String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employer_id               String                @db.VarChar(255)
  title                     String                @db.VarChar(255)
  description               String?
  industry                  String?               @db.VarChar(100)
  experience_years_required Int?
  budget                    Decimal?              @db.Decimal(10, 2)
  status                    String?               @default("OPEN") @db.VarChar(50)
  location                  String?               @db.VarChar(255)
  city                      String?               @db.VarChar(255)
  address                   String?
  latitude                  Float?
  longitude                 Float?
  created_at                DateTime?             @default(now()) @db.Timestamp(6)
  updated_at                DateTime?             @default(now()) @db.Timestamp(6)
  employer_name             String?               @db.VarChar(255)
  expires_at                DateTime?             @db.Timestamp(6)
  is_external               Boolean?              @default(false)
  source_name               String?               @db.VarChar(100)
  source_url                String?
  source_hash               String?               @db.VarChar(64)
  external_id               String?               @db.VarChar(255)
  alternate_sources         Json?
  date_posted               DateTime?             @db.Timestamp(6)
  last_verified_at          DateTime?             @db.Timestamp(6)
  job_applications          job_applications[]
  job_required_skills       job_required_skills[] @ignore
  saved_jobs                saved_jobs[]

  @@index([employer_id], map: "idx_jobs_employer_id")
  @@index([status], map: "idx_jobs_status")
  @@index([is_external, status], map: "idx_jobs_external_status")
  @@index([source_hash], map: "idx_jobs_source_hash")
  @@index([source_name, external_id], map: "idx_jobs_source_external_id")
}

model media_assets {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  url        String
  public_id  String    @db.VarChar(255)
  file_name  String?   @db.VarChar(255)
  file_type  String?   @db.VarChar(50)
  file_size  BigInt?
  owner_id   String    @db.VarChar(255)
  created_at DateTime? @default(now()) @db.Timestamp(6)
}

model notifications {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String    @db.VarChar(255)
  title      String    @db.VarChar(255)
  message    String
  link       String?   @db.VarChar(255)
  is_read    Boolean?  @default(false)
  type       String?   @db.VarChar(50)
  created_at DateTime? @default(now()) @db.Timestamp(6)
  updated_at DateTime? @default(now()) @db.Timestamp(6)

  @@index([user_id], map: "idx_notifications_user_id")
}

model user_fcm_tokens {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String    @db.VarChar(255)
  token       String    @unique @db.VarChar(500)
  device_type String?   @default("web") @db.VarChar(50)
  created_at  DateTime? @default(now()) @db.Timestamp(6)
  updated_at  DateTime? @default(now()) @db.Timestamp(6)

  @@index([user_id], map: "idx_user_fcm_tokens_user_id")
}

model user_search_alerts {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id          String    @db.VarChar(255)
  alert_type       String    @default("JOB_ALERT") @db.VarChar(50)
  title            String    @db.VarChar(255)
  query            String?   @db.VarChar(255)
  city             String?   @db.VarChar(255)
  category         String?   @db.VarChar(100)
  min_salary       Decimal?  @db.Decimal(10, 2)
  max_salary       Decimal?  @db.Decimal(10, 2)
  experience       String?   @db.VarChar(50)
  is_active        Boolean   @default(true)
  frequency        String    @default("INSTANT") @db.VarChar(50)
  last_notified_at DateTime? @db.Timestamp(6)
  match_count      Int       @default(0)
  created_at       DateTime? @default(now()) @db.Timestamp(6)
  updated_at       DateTime? @default(now()) @db.Timestamp(6)

  @@index([user_id], map: "idx_user_search_alerts_user_id")
  @@index([is_active, alert_type], map: "idx_user_search_alerts_active_type")
  @@index([city], map: "idx_user_search_alerts_city")
  @@index([category], map: "idx_user_search_alerts_category")
  @@index([last_notified_at], map: "idx_user_search_alerts_cooldown")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model ratings {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reviewer_id String    @db.VarChar(255)
  ratee_id    String    @db.VarChar(255)
  job_id      String    @db.Uuid
  score       Int
  comment     String?
  created_at  DateTime? @default(now()) @db.Timestamp(6)
  updated_at  DateTime? @default(now()) @db.Timestamp(6)

  @@index([ratee_id], map: "idx_ratings_ratee_id")
}

model skill_test_questions {
  id               String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  test_id          String      @db.Uuid
  question_text    String
  options          Json
  correct_option   Int
  points           Int?        @default(10)
  complexity_score Int?        @default(1)
  metadata         Json?
  skill_tests      skill_tests @relation(fields: [test_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model skill_test_results {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  worker_id    String      @db.VarChar(255)
  test_id      String      @db.Uuid
  score        Int
  passed       Boolean
  completed_at DateTime?   @default(now()) @db.Timestamp(6)
  skill_tests  skill_tests @relation(fields: [test_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([worker_id], map: "idx_skill_test_results_worker_id")
}

model skill_tests {
  id                   String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title                String                 @db.VarChar(255)
  category             String                 @db.VarChar(100)
  difficulty           String                 @db.VarChar(20)
  duration_minutes     Int
  points               Int?                   @default(100)
  description          String?
  created_at           DateTime?              @default(now()) @db.Timestamp(6)
  skill_test_questions skill_test_questions[]
  skill_test_results   skill_test_results[]
}

model support_tickets {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String?   @db.VarChar(255)
  subject    String    @db.VarChar(255)
  message    String
  status     String?   @default("OPEN") @db.VarChar(20)
  priority   String?   @default("NORMAL") @db.VarChar(20)
  created_at DateTime? @default(now()) @db.Timestamp(6)
  updated_at DateTime? @default(now()) @db.Timestamp(6)
}

model user_activities {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String    @db.VarChar(255)
  type        String    @db.VarChar(50)
  description String
  target_id   String?   @db.VarChar(255)
  created_at  DateTime? @default(now()) @db.Timestamp(6)
}

model user_metadata {
  id                 String    @id @db.Uuid
  email              String    @unique @db.VarChar(255)
  password_hash      String?   @db.VarChar(255)
  phone_number       String?   @db.VarChar(255)
  first_name         String?   @db.VarChar(255)
  last_name          String?   @db.VarChar(255)
  profile_image_url  String?
  role               String?   @db.VarChar(50)
  email_verified     Boolean?  @default(false)
  onboarded          Boolean?  @default(false)
  created_at         DateTime? @db.Timestamp(6)
  updated_at         DateTime? @db.Timestamp(6)
  reset_token        String?   @db.VarChar(255)
  reset_token_expiry DateTime? @db.Timestamp(6)
}

model user_settings {
  user_id             String    @id @db.VarChar(255)
  email_notifications Boolean?  @default(true)
  push_notifications  Boolean?  @default(true)
  marketing_emails    Boolean?  @default(false)
  theme               String?   @default("light") @db.VarChar(20)
  language            String?   @default("en") @db.VarChar(10)
  updated_at          DateTime? @default(now()) @db.Timestamp(6)
}

model verification_records {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id           String    @db.VarChar(255)
  doc_image_url     String?
  verification_type String?   @db.VarChar(50)
  status            String?   @default("PENDING") @db.VarChar(50)
  verified_at       DateTime? @db.Timestamp(6)
  created_at        DateTime? @default(now()) @db.Timestamp(6)
  updated_at        DateTime? @default(now()) @db.Timestamp(6)
  live_image_url    String?   @db.VarChar(255)
  confidence_score  String?   @db.VarChar(255)
  failure_reason    String?   @db.VarChar(255)

  @@index([user_id], map: "idx_verification_records_user_id")
}

model worker_profiles {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id               String    @unique @db.VarChar(255)
  full_name             String?   @db.VarChar(255)
  phone_number          String?   @db.VarChar(20)
  profile_image_url     String?
  bio                   String?
  skills                String?
  experience_years      Int?      @default(0)
  level                 String?   @default("L1") @db.VarChar(50)
  level_number          Int?      @default(1)
  skill_score           Float?    @default(30.0)
  experience_score      Float?    @default(0.0)
  performance_score     Float?    @default(0.0)
  reliability_score     Float?    @default(0.0)
  level_score           Float?    @default(0.0)
  trust_score           Int?      @default(0)
  hourly_rate           Decimal?  @db.Decimal(10, 2)
  profile_views         BigInt?   @default(0)
  is_available          Boolean?  @default(true)
  location              String?   @db.VarChar(255)
  city                  String?   @db.VarChar(255)
  area                  String?   @db.VarChar(255)
  address               String?
  latitude              Float?
  longitude             Float?
  dob                   DateTime? @db.Date
  gender                String?   @db.VarChar(20)
  whatsapp_opt_in       Boolean?  @default(true)
  willing_to_relocate   Boolean?  @default(false)
  preferred_cities      String?
  highest_education     String?   @db.VarChar(100)
  is_pursuing_education Boolean?  @default(false)
  college_name          String?   @db.VarChar(255)
  degree                String?   @db.VarChar(100)
  specialization        String?   @db.VarChar(100)
  school_medium         String?   @db.VarChar(50)
  english_proficiency   String?   @db.VarChar(50)
  languages_known       String?
  preferred_roles       String?
  resume_url            String?   @db.VarChar(500)
  whatsapp_number       String?   @db.VarChar(20)
  is_differently_abled  Boolean?  @default(false)
  disability_type       String?   @db.VarChar(100)
  disability_area       String?   @db.VarChar(100)
  disability_reason     String?   @db.VarChar(100)
  state                 String?   @db.VarChar(100)
  district              String?   @db.VarChar(100)
  taluk                 String?   @db.VarChar(100)
  town_panchayat        String?   @db.VarChar(150)
  pincode               String?   @db.VarChar(10)
  work_experience_type  String?   @default("FRESHER") @db.VarChar(20)
  created_at            DateTime? @default(now()) @db.Timestamp(6)
  updated_at            DateTime? @default(now()) @db.Timestamp(6)
  abscond_count         Int?      @default(0)
  completed_jobs        Int?      @default(0)
  total_jobs            Int?      @default(0)

  @@index([user_id], map: "idx_worker_profiles_user_id")
  @@index([city, area], map: "idx_worker_profiles_city_area")
  @@index([state, district], map: "idx_worker_profiles_state_district")
}

model worker_search_index {
  user_id           String    @id @db.VarChar(255)
  name              String    @db.VarChar(255)
  bio               String?
  skills            String?
  location          String?   @db.VarChar(255)
  city              String?   @db.VarChar(255)
  latitude          Float?
  longitude         Float?
  level             String?   @db.VarChar(50)
  is_verified       Boolean?  @default(false)
  profile_image_url String?
  status            String?   @default("AVAILABLE") @db.VarChar(50)
  indexed_at        DateTime? @default(now()) @db.Timestamp(6)
  last_updated_at   DateTime? @default(now()) @db.Timestamp(6)
  trust_score       Int?      @default(0)
}

model saved_jobs {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String    @db.VarChar(255)
  job_id     String    @db.Uuid
  created_at DateTime? @default(now()) @db.Timestamp(6)
  jobs       jobs      @relation(fields: [job_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, job_id], map: "uq_saved_jobs_user_job")
  @@index([user_id], map: "idx_saved_jobs_user_id")
  @@index([job_id], map: "idx_saved_jobs_job_id")
}

model saved_workers {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employer_id String    @db.VarChar(255)
  worker_id   String    @db.VarChar(255)
  created_at  DateTime? @default(now()) @db.Timestamp(6)

  @@unique([employer_id, worker_id], map: "uq_saved_workers_employer_worker")
  @@index([employer_id], map: "idx_saved_workers_employer_id")
  @@index([worker_id], map: "idx_saved_workers_worker_id")
}

model employer_leads {
  id                    String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  company_name          String                      @db.VarChar(255)
  normalized_name       String                      @db.VarChar(255)
  company_domain        String?                     @db.VarChar(255)
  company_website       String?
  industry              String?                     @db.VarChar(100)
  city                  String?                     @db.VarChar(100)
  state                 String?                     @db.VarChar(100)
  address               String?
  official_email        String?                     @db.VarChar(255)
  official_phone        String?                     @db.VarChar(50)
  contact_page_url      String?
  contactability_score  String                      @default("PARTIAL") @db.VarChar(20) // COMPLETE, PARTIAL, UNCONTACTABLE
  status                String                      @default("DISCOVERED") @db.VarChar(50) // DISCOVERED, REVIEWING, VERIFIED, CONTACTABLE, CONTACTED, RESPONDED, INTERESTED, ONBOARDED, INVALID, DUPLICATE, EXPIRED, NOT_INTERESTED
  trusthire_employer_id String?                     @db.Uuid
  created_at            DateTime                    @default(now()) @db.Timestamp(6)
  updated_at            DateTime                    @default(now()) @db.Timestamp(6)

  requirements          employer_lead_requirements[]
  outreach_logs         lead_outreach_logs[]

  @@index([normalized_name], map: "idx_employer_leads_normalized_name")
  @@index([company_domain], map: "idx_employer_leads_domain")
  @@index([status], map: "idx_employer_leads_status")
  @@index([city], map: "idx_employer_leads_city")
}

model employer_lead_requirements {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lead_id          String         @db.Uuid
  title            String         @db.VarChar(255)
  normalized_title String         @db.VarChar(255)
  category         String?        @db.VarChar(100)
  description      String?
  city             String?        @db.VarChar(100)
  location         String?        @db.VarChar(255)
  workers_needed   Int?           @default(1)
  salary_range     String?        @db.VarChar(100)
  source_name      String         @db.VarChar(100)
  source_url       String
  source_hash      String         @db.VarChar(64)
  is_verified      Boolean        @default(false)
  discovered_at    DateTime       @default(now()) @db.Timestamp(6)
  last_seen_at     DateTime       @default(now()) @db.Timestamp(6)
  status           String         @default("OPEN") @db.VarChar(50) // OPEN, FILLED, EXPIRED, ARCHIVED

  employer_lead    employer_leads @relation(fields: [lead_id], references: [id], onDelete: Cascade)

  @@index([lead_id], map: "idx_lead_req_lead_id")
  @@index([source_hash], map: "idx_lead_req_source_hash")
  @@index([status], map: "idx_lead_req_status")
}

model lead_outreach_logs {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lead_id        String         @db.Uuid
  admin_id       String         @db.VarChar(255)
  channel        String         @db.VarChar(50) // PHONE, EMAIL, IN_PERSON, CONTACT_FORM
  contact_target String?        @db.VarChar(255)
  notes          String
  outcome        String?        @db.VarChar(50) // INTERESTED, FOLLOW_UP, NOT_INTERESTED, NO_ANSWER
  contacted_at   DateTime       @default(now()) @db.Timestamp(6)

  employer_lead  employer_leads @relation(fields: [lead_id], references: [id], onDelete: Cascade)

  @@index([lead_id], map: "idx_outreach_lead_id")
}

model translation_cache {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  content_hash    String   @unique @db.VarChar(64)
  source_lang     String   @default("en") @db.VarChar(10)
  target_lang     String   @db.VarChar(10)
  source_text     String
  translated_text String
  hit_count       Int      @default(1)
  created_at      DateTime @default(now()) @db.Timestamp(6)
  updated_at      DateTime @default(now()) @db.Timestamp(6)

  @@index([content_hash], map: "idx_trans_content_hash")
  @@index([target_lang], map: "idx_trans_target_lang")
}

model location_master {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  state         String    @db.VarChar(100)
  district      String    @db.VarChar(100)
  taluk         String?   @db.VarChar(100)
  locality_name String    @db.VarChar(150)
  locality_type String    @db.VarChar(50)
  pincode       String?   @db.VarChar(10)
  created_at    DateTime? @default(now()) @db.Timestamp(6)

  @@index([state], map: "idx_loc_state")
  @@index([state, district], map: "idx_loc_state_district")
  @@index([district, locality_name], map: "idx_loc_district_locality")
  @@index([pincode], map: "idx_loc_pincode")
}

model onboarding_master_options {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  category   String    @db.VarChar(50)
  option_key String    @db.VarChar(100)
  label_en   String    @db.VarChar(255)
  label_ta   String?   @db.VarChar(255)
  sort_order Int       @default(0)
  is_active  Boolean   @default(true)
  created_at DateTime? @default(now()) @db.Timestamp(6)

  @@unique([category, option_key], map: "uq_onboard_cat_key")
  @@index([category, is_active, sort_order], map: "idx_onboard_category_active")
}



