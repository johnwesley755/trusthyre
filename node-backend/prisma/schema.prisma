model work_orders {
  id                    String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_number          String              @unique @db.VarChar(50)
  job_id                String?             @db.Uuid
  application_id        String?             @db.Uuid
  employer_id           String              @db.VarChar(255)
  worker_id             String              @db.VarChar(255)
  
  job_title             String              @db.VarChar(255)
  work_description      String?
  worksite_name         String              @db.VarChar(255)
  worksite_address      String
  city                  String              @db.VarChar(100)
  district              String?             @db.VarChar(100)
  taluk                 String?             @db.VarChar(100)
  latitude              Float?
  longitude             Float?
  
  start_date            DateTime            @db.Date
  expected_end_date     DateTime?           @db.Date
  work_duration_days    Int?
  shift_timing          String              @db.VarChar(100)
  weekly_rest_day       String?             @default("SUNDAY") @db.VarChar(50)
  daily_working_hours   Decimal             @default(8.00) @db.Decimal(4, 2)
  overtime_terms        String?
  
  wage_amount           Decimal             @db.Decimal(10, 2)
  wage_frequency        String              @default("DAILY") @db.VarChar(50)
  food_provided         Boolean?            @default(false)
  accommodation_provided Boolean?           @default(false)
  transport_provided    Boolean?            @default(false)
  other_benefits        String?
  agreed_deductions     String?
  
  status                String              @default("DRAFT") @db.VarChar(50)
  worker_response_notes String?
  accepted_at           DateTime?           @db.Timestamp(6)
  declined_at           DateTime?           @db.Timestamp(6)
  terms_version         Int                 @default(1)
  accepted_terms_version Int?
  accepted_terms_hash   String?             @db.VarChar(64)
  created_at            DateTime?           @default(now()) @db.Timestamp(6)
  updated_at            DateTime?           @default(now()) @db.Timestamp(6)
  
  jobs                  jobs?               @relation(fields: [job_id], references: [id], onDelete: SetNull)
  job_applications      job_applications?   @relation(fields: [application_id], references: [id], onDelete: SetNull)
  events                work_order_events[]
  terms_versions        work_order_terms_versions[]
  shifts                shifts[]
  shift_attendances     shift_attendances[]

  @@index([employer_id], map: "idx_work_orders_employer_id")
  @@index([worker_id], map: "idx_work_orders_worker_id")
  @@index([status], map: "idx_work_orders_status")
  @@index([job_id], map: "idx_work_orders_job_id")
  @@index([created_at(sort: Desc)], map: "idx_work_orders_created_at")
}

model work_order_events {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  work_order_id  String      @db.Uuid
  actor_id       String      @db.VarChar(255)
  actor_role     String      @db.VarChar(50)
  event_type     String      @db.VarChar(50)
  notes          String?
  snapshot       Json?
  created_at     DateTime?   @default(now()) @db.Timestamp(6)

  work_orders    work_orders @relation(fields: [work_order_id], references: [id], onDelete: Cascade)

  @@index([work_order_id], map: "idx_work_order_events_wo_id")
  @@index([created_at(sort: Desc)], map: "idx_work_order_events_created_at")
}

model shifts {
  id                     String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  work_order_id          String              @db.Uuid
  employer_id            String              @db.VarChar(255)
  worker_id              String              @db.VarChar(255)
  supervisor_id          String?             @db.VarChar(255)
  shift_date             DateTime            @db.Date
  start_time             String              @db.VarChar(10)
  end_time               String              @db.VarChar(10)
  break_duration_minutes Int                 @default(60)
  worksite_name          String              @db.VarChar(255)
  worksite_address       String
  city                   String              @db.VarChar(100)
  status                 String              @default("SCHEDULED") @db.VarChar(50)
  recurrence_rule        String?             @db.VarChar(100)
  notes                  String?
  created_at             DateTime?           @default(now()) @db.Timestamp(6)
  updated_at             DateTime?           @default(now()) @db.Timestamp(6)

  work_orders            work_orders         @relation(fields: [work_order_id], references: [id], onDelete: Cascade)
  attendances            shift_attendances[]
  challenges             attendance_challenges[]

  @@index([work_order_id], map: "idx_shifts_work_order_id")
  @@index([employer_id], map: "idx_shifts_employer_id")
  @@index([worker_id], map: "idx_shifts_worker_id")
  @@index([shift_date, status], map: "idx_shifts_date_status")
}

model shift_attendances {
  id                           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shift_id                     String       @db.Uuid
  work_order_id                String       @db.Uuid
  worker_id                    String       @db.VarChar(255)
  employer_id                  String       @db.VarChar(255)
  supervisor_id                String?      @db.VarChar(255)
  status                       String       @default("NOT_STARTED") @db.VarChar(50)
  verification_method          String       @default("QR_CODE") @db.VarChar(50)
  check_in_time                DateTime?    @db.Timestamp(6)
  check_out_time               DateTime?    @db.Timestamp(6)
  break_start_time             DateTime?    @db.Timestamp(6)
  break_end_time               DateTime?    @db.Timestamp(6)
  total_work_minutes           Int          @default(0)
  total_break_minutes          Int          @default(0)
  check_in_lat                 Float?
  check_in_lng                 Float?
  check_out_lat                Float?
  check_out_lng                Float?
  check_in_notes               String?
  check_out_notes              String?
  manual_reason                String?
  correction_requested_time    DateTime?    @db.Timestamp(6)
  correction_reason            String?
  correction_proposed_check_in DateTime?    @db.Timestamp(6)
  correction_proposed_check_out DateTime?   @db.Timestamp(6)
  last_break_start             DateTime?    @db.Timestamp(6)
  approved_by                  String?      @db.VarChar(255)
  approved_at                  DateTime?    @db.Timestamp(6)
  correction_resolved_by       String?      @db.VarChar(255)
  correction_resolved_at       DateTime?    @db.Timestamp(6)
  correction_resolution_notes  String?
  events                       Json         @default("[]")
  created_at                   DateTime?    @default(now()) @db.Timestamp(6)
  updated_at                   DateTime?    @default(now()) @db.Timestamp(6)

  shifts                       shifts       @relation(fields: [shift_id], references: [id], onDelete: Cascade)
  work_orders                  work_orders  @relation(fields: [work_order_id], references: [id], onDelete: Cascade)
  attendance_events            attendance_events[]

  @@unique([shift_id, worker_id], map: "uq_shift_attendance_shift_worker")
  @@index([worker_id], map: "idx_attendances_worker_id")
  @@index([employer_id], map: "idx_attendances_employer_id")
  @@index([status], map: "idx_attendances_status")
  @@index([created_at(sort: Desc)], map: "idx_attendances_created_at")
}

model attendance_challenges {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shift_id        String    @db.Uuid
  challenge_type  String    @db.VarChar(20)
  intended_action String    @db.VarChar(20)
  hashed_secret   String    @db.VarChar(255)
  nonce           String    @unique @db.VarChar(64)
  issuer_user_id  String    @db.VarChar(255)
  expires_at      DateTime  @db.Timestamptz(6)
  attempt_count   Int       @default(0)
  max_attempts    Int       @default(3)
  consumed_at     DateTime? @db.Timestamptz(6)
  created_at      DateTime? @default(now()) @db.Timestamptz(6)

  shifts          shifts    @relation(fields: [shift_id], references: [id], onDelete: Cascade)

  @@index([shift_id, intended_action, expires_at], map: "idx_attendance_challenges_shift_action")
  @@index([nonce], map: "idx_attendance_challenges_nonce")
}

model work_order_terms_versions {
  id                 String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  work_order_id      String      @db.Uuid
  version_number     Int
  terms_snapshot     Json
  terms_hash         String      @db.VarChar(64)
  created_by_user_id String      @db.VarChar(255)
  change_summary     String?
  created_at         DateTime?   @default(now()) @db.Timestamptz(6)

  work_orders        work_orders @relation(fields: [work_order_id], references: [id], onDelete: Cascade)

  @@unique([work_order_id, version_number], map: "uq_work_order_version")
  @@index([work_order_id, version_number], map: "idx_work_order_terms_work_order")
}

model attendance_events {
  id                  String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  attendance_id       String            @db.Uuid
  event_type          String            @db.VarChar(50)
  actor_user_id       String            @db.VarChar(255)
  actor_role          String            @db.VarChar(50)
  verification_method String?           @db.VarChar(50)
  latitude            Float?
  longitude           Float?
  notes               String?
  event_data          Json              @default("{}")
  created_at          DateTime?         @default(now()) @db.Timestamptz(6)

  attendances         shift_attendances @relation(fields: [attendance_id], references: [id], onDelete: Cascade)

  @@index([attendance_id, created_at], map: "idx_attendance_events_attendance_id")
}






